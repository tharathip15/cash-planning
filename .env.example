# Local development uses the dedicated loopback service; Production uses its HTTPS endpoint.
CASH_BACKEND_URL=http://127.0.0.1:8792
CASH_BACKEND_KEY=replace-with-a-random-secret-at-least-48-characters
# Production: configure this Sensitive variable instead of CASH_BACKEND_URL.
# CASH_BACKEND_DISCOVERY_URL=https://edge-config.vercel.com/CONFIG_ID/item/cashBackendUrl?token=READ_TOKEN
